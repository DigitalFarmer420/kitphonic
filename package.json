{
  "name": "kitphonic",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "manifest": "node tools/build-manifest.mjs",
    "start": "node tools/serve.mjs",
    "check:sizes": "sh tools/check-sizes.sh",
    "android:stage": "node tools/stage-android-www.mjs",
    "android:sync": "node tools/stage-android-www.mjs && cap sync android",
    "android:debug": "node tools/stage-android-www.mjs && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
